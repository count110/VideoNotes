# Copy this file to .env only for local development. Do not commit .env.
# A production process manager / secret manager should inject these values.

# The Feishu self-built application's credentials. App Secret never goes into
# VideoNotes, source code, logs, or the App Store build.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_with_feishu_app_secret

# At least one Feishu Open ID is required. Only these people may bind a group
# to a VideoNotes device; after binding, only the person who bound it may run
# commands in that group. Find the Open ID in Feishu developer tools.
FEISHU_BINDER_OPEN_IDS=ou_replace_me

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This protects the encrypted on-disk relay state (device-token hashes,
# pairings, command/reply queue). Keep it stable across restarts/backups.
RELAY_STATE_ENCRYPTION_KEY=replace_with_32_byte_base64url_key

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Used only by a trusted administrator to mint a one-time pairing code.
RELAY_ADMIN_TOKEN=replace_with_32_byte_base64url_token

# Keep the HTTP process on loopback and put HTTPS/authenticated ingress in
# front of it in production. Do not expose this raw HTTP listener publicly.
RELAY_HOST=127.0.0.1
PORT=8787
RELAY_STATE_FILE=./data/relay-state.enc.json

# Feishu's China endpoint is the default. Set to lark for Lark Suite only.
FEISHU_DOMAIN=feishu

# Conservative limits. Do not increase without considering privacy/abuse.
RELAY_PAIRING_CODE_TTL_SECONDS=900
# A claim response can be retried if it was lost. If the Mac never completes
# group binding, its unbound device record is removed after this limit.
# Keep it at least as large as RELAY_PAIRING_CODE_TTL_SECONDS.
RELAY_UNBOUND_CLAIM_TTL_SECONDS=3600
RELAY_COMMAND_TTL_SECONDS=600
RELAY_COMMAND_LEASE_SECONDS=60
RELAY_MAX_PENDING_COMMANDS=3

# Per-group command and pairing safeguards. These are intentionally modest;
# a public HTTPS gateway should additionally rate-limit requests before they
# reach this loopback-only process.
RELAY_BIND_RATE_WINDOW_SECONDS=600
RELAY_BIND_ATTEMPTS_PER_WINDOW=5
RELAY_COMMAND_RATE_WINDOW_SECONDS=60
RELAY_COMMANDS_PER_WINDOW=6
RELAY_HTTP_RATE_WINDOW_SECONDS=600
RELAY_HTTP_PAIRING_CLAIMS_PER_WINDOW=20
RELAY_HTTP_ADMIN_PAIRINGS_PER_WINDOW=20
RELAY_RATE_LIMIT_MAX_KEYS=5000
